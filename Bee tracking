        "import cv2\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "from scipy.stats import ttest_ind\n",
        "\n",
        "# Configuration\n",
        "VIDEOS = {\n",
        "    'Control1': 'control_control1.avi',\n",
        "    'Nicotine1': 'control_nicotine1.avi',\n",
        "    'Control2': 'test_control2.avi',\n",
        "    'Nicotine2': 'test_nicotine2.avi'\n",
        "}\n",
        "\n",
        "# Enhanced tracking function\n",
        "def track_bee(video_path):\n",
        "    cap = cv2.VideoCapture(video_path)\n",
        "    positions = []\n",
        "    frame_count = 0\n",
        "\n",
        "    # Optimized background subtractor\n",
        "    fgbg = cv2.createBackgroundSubtractorMOG2(\n",
        "        history=300,\n",
        "        varThreshold=25,\n",
        "        detectShadows=False\n",
        "    )\n",
        "\n",
        "    while cap.isOpened():\n",
        "        ret, frame = cap.read()\n",
        "        if not ret:\n",
        "            break\n",
        "\n",
        "        # Adaptive preprocessing\n",
        "        gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)\n",
        "        blurred = cv2.GaussianBlur(gray, (7,7), 0)\n",
        "        fgmask = fgbg.apply(blurred)\n",
        "\n",
        "        # Morphological cleanup\n",
        "        kernel = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (5,5))\n",
        "        cleaned = cv2.morphologyEx(fgmask, cv2.MORPH_OPEN, kernel)\n",
