      "cell_type": "code",
      "source": [
        "import cv2 as cv\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "from scipy.spatial.distance import euclidean\n",
        "from collections import deque\n",
        "\n",
        "# @title Enhanced Video Processing with Behavior Analysis\n",
        "videoPath = \"/content/control_control1.avi\"\n",
        "output_csv = \"/content/bee_behavior_analysis.csv\"\n",
        "output_video = \"/content/bee_tracking_output.avi\"\n",
        "\n",
        "# Initialize video capture\n",
        "cap = cv.VideoCapture(videoPath)\n",
        "frame_count = int(cap.get(cv.CAP_PROP_FRAME_COUNT))\n",
        "fps = cap.get(cv.CAP_PROP_FPS)\n",
        "width = int(cap.get(cv.CAP_PROP_FRAME_WIDTH))\n",
        "height = int(cap.get(cv.CAP_PROP_FRAME_HEIGHT))\n",
        "\n",
        "# Video writer for output\n",
        "fourcc = cv.VideoWriter_fourcc(*'XVID')\n",
        "out = cv.VideoWriter(output_video, fourcc, fps, (width, height))\n",
        "\n",
        "# Processing parameters\n",
        "kernel_size = 25\n",
        "kernel = np.ones((kernel_size, kernel_size), np.uint8)\n",
        "min_area = 1500\n",
        "max_area = 7000\n",
        "velocity_window = 5  # frames for velocity smoothing\n",
        "\n",
        "# Data storage structure\n",
        "class BeeTracker:\n",
        "    def __init__(self, max_bees=5):\n",
        "        self.positions = {f'fly{i}': {'x': np.full(frame_count, np.nan),\n",
        "                                     'y': np.full(frame_count, np.nan),\n",
        "                                     'velocity': np.full(frame_count, np.nan),\n",
        "                                     'activity': np.full(frame_count, np.nan)}\n",
        "                         for i in range(max_bees)}\n",
        "        self.current_ids = []\n",
        "        self.trail_history = {f'fly{i}': deque(maxlen=30) for i in range(max_bees)}\n",
        "\n",
        "    def update(self, frame_idx, contours):\n",
        "        # Match current contours to existing tracks\n",
        "        matched = set()\n",
        "\n",
        "        for bee_id in self.current_ids:\n",
        "            # Find closest contour to previous position\n",
        "            if frame_idx > 0 and not np.isnan(self.positions[bee_id]['x'][frame_idx-1]):\n",
        "                last_pos = (self.positions[bee_id]['x'][frame_idx-1],\n",
        "                           self.positions[bee_id]['y'][frame_idx-1])\n",
        "\n",
        "                min_dist = float('inf')\n",
        "                best_contour = None\n",
        "\n",
        "                for i, contour in enumerate(contours):\n",
        "                    if i in matched:\n",
        "                        continue\n",
        "\n",
        "                    M = cv.moments(contour)\n",
        "                    if M[\"m00\"] == 0:\n",
        "                        continue\n",
        "                    cX = int(M[\"m10\"] / M[\"m00\"])\n",
        "                    cY = int(M[\"m01\"] / M[\"m00\"])\n",
        "\n",
        "                    dist = euclidean(last_pos, (cX, cY))\n",
        "                    if dist < min_dist:\n",
        "                        min_dist = dist\n",
        "                        best_contour = (i, cX, cY)\n",
        "\n",
        "                if best_contour and min_dist < 100:  # Max movement threshold\n",
        "                    i, cX, cY = best_contour\n",
        "                    self.positions[bee_id]['x'][frame_idx] = cX\n",
        "                    self.positions[bee_id]['y'][frame_idx] = cY\n",
        "                    matched.add(i)\n",
        "                    self.trail_history[bee_id].append((cX, cY))\n",
        "\n",
        "        # Add new bees for unmatched contours\n",
        "        for i, contour in enumerate(contours):\n",
        "            if i not in matched:\n",
        "                M = cv.moments(contour)\n",
        "                if M[\"m00\"] == 0:\n",
        "                    continue\n",
        "                cX = int(M[\"m10\"] / M[\"m00\"])\n",
        "                cY = int(M[\"m01\"] / M[\"m00\"])\n",
        "\n",
        "                # Find available bee ID\n",
        "                for bee_id in self.positions:\n",
        "                    if np.all(np.isnan(self.positions[bee_id]['x'][:frame_idx])):\n",
        "                        self.positions[bee_id]['x'][frame_idx] = cX\n",
        "                        self.positions[bee_id]['y'][frame_idx] = cY\n",
        "                        self.trail_history[bee_id].append((cX, cY))\n",
        "                        if bee_id not in self.current_ids:\n",
        "                            self.current_ids.append(bee_id)\n",
        "                        break\n",
        "\n",
        "        # Calculate velocities and activity\n",
        "        for bee_id in self.current_ids:\n",
        "            if frame_idx > 0 and not np.isnan(self.positions[bee_id]['x'][frame_idx]):\n",
        "                if not np.isnan(self.positions[bee_id]['x'][frame_idx-1]):\n",
        "                    dx = self.positions[bee_id]['x'][frame_idx] - self.positions[bee_id]['x'][frame_idx-1]\n",
        "                    dy = self.positions[bee_id]['y'][frame_idx] - self.positions[bee_id]['y'][frame_idx-1]\n",
        "                    self.positions[bee_id]['velocity'][frame_idx] = np.sqrt(dx**2 + dy**2) * fps  # pixels/second\n",
        "\n",
        "                    # Simple activity measure (1 if moving, 0 if not)\n",
        "                    self.positions[bee_id]['activity'][frame_idx] = 1 if self.positions[bee_id]['velocity'][frame_idx] > 10 else 0\n",
        "\n",
        "# Initialize tracker\n",
        "tracker = BeeTracker()\n",
        "\n",
        "# Process video\n",
        "frame_idx = 0\n",
        "while cap.isOpened():\n",
        "    ret, frame = cap.read()\n",
        "    if not ret:\n",
        "        break\n",
        "\n",
        "    # Preprocessing\n",
        "    gray = cv.cvtColor(frame, cv.COLOR_BGR2GRAY)\n",
        "    _, binary = cv.threshold(gray, 100, 255, cv.THRESH_BINARY_INV)\n",
        "\n",
        "    # Noise removal\n",
        "    eroded = cv.erode(binary, kernel, iterations=1)\n",
        "    dilated = cv.dilate(eroded, kernel, iterations=1)\n",
        "\n",
        "    # Find contours\n",
        "    contours, _ = cv.findContours(dilated, cv.RETR_TREE, cv.CHAIN_APPROX_SIMPLE)\n",
        "\n",
        "    # Filter contours by size\n",
        "    filtered_contours = []\n",
        "    for contour in contours:\n",
        "        area = cv.contourArea(contour)\n",
        "        if min_area < area < max_area:\n",
        "            filtered_contours.append(contour)\n",
        "\n",
        "    # Update tracker\n",
        "    tracker.update(frame_idx, filtered_contours)\n",
        "\n",
        "    # Visualization\n",
        "    for bee_id in tracker.current_ids:\n",
        "        if not np.isnan(tracker.positions[bee_id]['x'][frame_idx]):\n",
        "            x = int(tracker.positions[bee_id]['x'][frame_idx])\n",
        "            y = int(tracker.positions[bee_id]['y'][frame_idx])\n",
        "\n",
        "            # Draw current position\n",
        "            cv.circle(frame, (x, y), 8, (0, 0, 255), -1)\n",
        "\n",
        "            # Draw trail\n",
        "            trail = list(tracker.trail_history[bee_id])\n",
        "            for i in range(1, len(trail)):\n",
        "                cv.line(frame, trail[i-1], trail[i], (0, 255, 0), 2)\n",
        "\n",
        "            # Label with velocity\n",
        "            vel = tracker.positions[bee_id]['velocity'][frame_idx]\n",
        "            if not np.isnan(vel):\n",
        "                cv.putText(frame, f\"{vel:.1f} px/s\", (x+10, y),\n",
        "                          cv.FONT_HERSHEY_SIMPLEX, 0.5, (255, 255, 255), 1)\n",
        "\n",
        "    # Write frame to output\n",
        "    out.write(frame)\n",
        "\n",
        "    frame_idx += 1\n",
        "    if frame_idx % 100 == 0:\n",
        "        print(f\"Processed frame {frame_idx}/{frame_count}\")\n",
        "\n",
        "cap.release()\n",
        "out.release()\n",
        "\n",
        "# Compile results into DataFrame\n",
        "results = {}\n",
        "for bee_id in tracker.positions:\n",
        "    for metric in ['x', 'y', 'velocity', 'activity']:\n",
        "        results[f\"{bee_id}_{metric}\"] = tracker.positions[bee_id][metric]\n",
        "\n",
        "df = pd.DataFrame(results)\n",
        "df['frame'] = df.index\n",
        "df['time'] = df['frame'] / fps\n",
        "\n",
        "# Save results\n",
        "df.to_csv(output_csv, index=False)\n",
        "print(f\"Results saved to {output_csv}\")\n",
        "print(f\"Tracking video saved to {output_video}\")\n",
        "\n",
        "# Analyze behavior changes\n",
        "def analyze_behavior(df, bee_id='fly0', velocity_threshold=50, inactive_threshold=1.0):\n",
        "    \"\"\"Analyze behavior patterns from tracking data\"\"\"\n",
        "    vel = df[f\"{bee_id}_velocity\"]\n",
        "    active = df[f\"{bee_id}_activity\"]\n",
        "\n",
        "    # Calculate statistics\n",
        "    stats = {\n",
        "        'total_distance': np.nansum(vel) / fps,\n",
        "        'mean_velocity': np.nanmean(vel),\n",
        "        'max_velocity': np.nanmax(vel),\n",
        "        'active_frames': np.nansum(active),\n",
        "        'inactive_frames': len(active) - np.nansum(active)\n",
        "    }\n",
        "\n",
        "    # Detect movement bursts (rapid acceleration)\n",
        "    high_speed = vel > velocity_threshold\n",
        "    stats['high_speed_episodes'] = high_speed.sum()\n",
        "\n",
        "    # Detect inactive periods\n",
        "    inactive_periods = []\n",
        "    current_period = 0\n",
        "    for a in active:\n",
        "        if np.isnan(a) or a == 1:\n",
        "            if current_period > 0:\n",
        "                if current_period/fps >= inactive_threshold:\n",
        "                    inactive_periods.append(current_period/fps)\n",
        "                current_period = 0\n",
        "        else:\n",
        "            current_period += 1\n",
        "\n",
        "    stats['long_inactive_periods'] = len(inactive_periods)\n",
        "    stats['mean_inactive_duration'] = np.mean(inactive_periods) if inactive_periods else 0\n",
        "\n",
        "    return stats\n",
        "\n",
        "# Example analysis for first bee\n",
        "bee_stats = analyze_behavior(df, 'fly0')\n",
        "print(\"\\nBehavior Analysis for fly0:\")\n",
        "for k, v in bee_stats.items():\n",
        "    print(f\"{k:>25}: {v:.2f}\")\n",
        "\n",
        "# Plotting\n",
        "plt.figure(figsize=(12, 6))\n",
        "plt.plot(df['time'], df['fly0_velocity'], label='Velocity (px/s)')\n",
        "plt.plot(df['time'], df['fly0_activity']*50, label='Activity (binary)')\n",
        "plt.xlabel('Time (seconds)')\n",
        "plt.ylabel('Velocity / Activity')\n",
        "plt.title('Control Bee Movement Analysis (Control)')\n",
        "plt.legend()\n",
        "plt.grid()\n",
        "plt.savefig('/content/bee_movement_plot.png')\n",
        "plt.show()"
      ],
