        "def analyze_movement(df, midline_x, stimulus_change=None):\n",
        "    \"\"\"Calculates essential movement statistics.\"\"\"\n",
        "    metrics = {}\n",
        "\n",
        "    # Basic movement\n",
        "    dx = np.diff(df[\"X\"])\n",
        "    dy = np.diff(df[\"Y\"])\n",
        "    metrics[\"total_distance\"] = np.sum(np.sqrt(dx**2 + dy**2))\n",
        "    metrics[\"avg_speed\"] = metrics[\"total_distance\"] / df[\"Time\"].max()\n",
        "\n",
        "    # Side preference\n",
        "    side = np.where(df[\"X\"] < midline_x, \"Left\", \"Right\")\n",
        "    metrics[\"time_left\"] = np.sum(side == \"Left\") / len(df)\n",
        "\n",
        "    # Stimulus response (if applicable)\n",
        "    if stimulus_change:\n",
        "        before = df[df[\"Time\"] < stimulus_change]\n",
        "        after = df[df[\"Time\"] >= stimulus_change]\n",
        "        metrics[\"response_latency\"] = after[after[\"X\"] >= midline_x][\"Time\"].min() - stimulus_change\n",
        "\n",
        "    return metrics\n",
        "\n",
        "# Example usage\n",
