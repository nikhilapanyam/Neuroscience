        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "def calculate_attention_metrics(positions, movement_threshold=10):\n",
        "    \"\"\"Safe metric calculation with input validation\"\"\"\n",
        "    # Validate input\n",
        "    if not isinstance(positions, np.ndarray) or len(positions.shape) != 2 or positions.shape[1] < 3:\n",
        "        print(f\"Invalid position data format. Expected shape (n,3), got {positions.shape if hasattr(positions, 'shape') else type(positions)}\")\n",
        "        return None\n",
        "\n",
        "    if len(positions) < 2:\n",
        "        print(\"Not enough data points (need at least 2 frames)\")\n",
        "        return None\n",
        "\n",
        "    try:\n",
        "        # Calculate movement distances\n",
        "        displacements = np.sqrt(np.sum(np.diff(positions[:,1:3], axis=0)**2, axis=1))\n",
        "\n",
        "        # Focus analysis\n",
        "        is_focused = displacements < movement_threshold\n",
        "        focus_metrics = {\n",
        "            'total_focus_frames': int(np.sum(is_focused)),\n",
        "            'focus_episodes': int(len(np.where(np.diff(is_focused.astype(int)) == 1)[0])),\n",
        "            'exploration_ratio': float(np.mean(displacements >= movement_threshold))\n",
        "        }\n",
        "\n",
        "        # Add duration stats if any focus episodes exist\n",
        "        if focus_metrics['focus_episodes'] > 0:\n",
        "            changes = np.diff(is_focused.astype(int))\n",
        "            starts = np.where(changes == 1)[0]\n",
        "            ends = np.where(changes == -1)[0]\n",
        "\n",
        "            # Handle edge cases\n",
        "            if is_focused[0]:\n",
        "                starts = np.insert(starts, 0, 0)\n",
        "            if is_focused[-1]:\n",
        "                ends = np.append(ends, len(is_focused)-1)\n",
        "\n",
        "            durations = ends - starts\n",
        "            focus_metrics.update({\n",
        "                'avg_focus_duration': float(np.mean(durations)),\n",
        "                'max_focus_duration': int(np.max(durations))\n",
        "            })\n",
        "        else:\n",
        "            focus_metrics.update({\n",
        "                'avg_focus_duration': 0.0,\n",
        "                'max_focus_duration': 0\n",
        "            })\n",
        "\n",
        "        return focus_metrics\n",
        "\n",
        "    except Exception as e:\n",
        "        print(f\"Analysis failed: {str(e)}\")\n",
